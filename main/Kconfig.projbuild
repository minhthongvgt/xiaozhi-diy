            default -1

        config CUSTOM_TOUCH_SLIDER_PAD2_GPIO
            int "Chân Touch Pad 2 của thanh trượt (GPIO 1-14)"
            depends on CUSTOM_ENABLE_TOUCH_SLIDER
            range -1 48
            default -1

        config CUSTOM_TOUCH_SLIDER_PAD3_GPIO
            int "Chân Touch Pad 3 của thanh trượt (GPIO 1-14)"
            depends on CUSTOM_ENABLE_TOUCH_SLIDER
            range -1 48
            default -1

        config CUSTOM_ENABLE_PERIPH_ROTARY_ENCODER
            bool "Núm vặn xoay vô cấp cơ học (Rotary Encoder EC11 qua PCNT)"
            default n
            help
                Núm xoay chiết áp số vô hạn để điều chỉnh âm lượng, độ sáng hoặc cuộn menu.

        if CUSTOM_ENABLE_PERIPH_ROTARY_ENCODER
            config CUSTOM_PERIPH_ENCODER_PHASE_A
                int "Chân xung pha A (CLK) Encoder"
                range -1 48
                default -1

            config CUSTOM_PERIPH_ENCODER_PHASE_B
                int "Chân xung pha B (DT) Encoder"
                range -1 48
                default -1

            config CUSTOM_PERIPH_ENCODER_KEY_PIN
                int "Chân phím nhấn SW Encoder (-1 nếu không dùng)"
                range -1 48
                default -1
        endif

        config CUSTOM_ENABLE_USER_CUSTOM_SENSORS
            bool "Driver Cảm biến ngoại vi tùy chỉnh (Custom User Sensor Hook)"
            default n
            help
                Kích hoạt móc hàm InitializeUserCustomSensors() trong UserDriverRegistry để người dùng khởi tạo bất kỳ cảm biến I2C/SPI tùy chọn nào.

        endmenu

        menu "4.2. Hệ thống chính (Main System)"
        menuconfig ENABLE_CUSTOM_CAMERA
            bool "Camera & Thị giác AI (Camera DVP / USB UVC)"
            default n
            help
                Bật/tắt hỗ trợ camera chụp ảnh và gửi dữ liệu thị giác cho AI Xiaozhi.

        if ENABLE_CUSTOM_CAMERA
            choice CUSTOM_CAMERA_SENSOR_TYPE
                prompt "Cảm Biến Camera (Camera Sensor Model)"
                default CUSTOM_CAMERA_OV2640

                config CUSTOM_CAMERA_OV2640
                    bool "OmniVision OV2640 (2 Megapixel)"
                config CUSTOM_CAMERA_OV3660
                    bool "OmniVision OV3660 (3 Megapixel)"
                config CUSTOM_CAMERA_OV5640
                    bool "OmniVision OV5640 (5 Megapixel)"
                config CUSTOM_CAMERA_SC030IOT
                    bool "SmartSens SC030IOT"
                config CUSTOM_CAMERA_USB_UVC
                    bool "USB UVC Web Camera (ESP32-S3 USB Host Port)"
                config CUSTOM_CAMERA_USER_CUSTOM
                    bool "Driver Camera tùy chỉnh (Custom User Camera Hook)"
            endchoice

            config CUSTOM_CAM_PIN_XCLK
