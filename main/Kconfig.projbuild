        # 2. Đèn LED & Động cơ
        menuconfig ENABLE_CUSTOM_LEDS
            bool "Đèn LED trạng thái & Động cơ Servo"
            default n
            help
                Cấu hình đèn LED trạng thái (WS2812, Single LED) và động cơ servo PWM.

        if ENABLE_CUSTOM_LEDS
