            config CUSTOM_CAM_PIN_D3
                int "Camera Data D3 Pin"
                depends on !CUSTOM_CAMERA_USB_UVC
                range -1 48
                default -1

            config CUSTOM_CAM_PIN_D4
                int "Camera Data D4 Pin"
                depends on !CUSTOM_CAMERA_USB_UVC
