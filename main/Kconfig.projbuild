        # 11. Cảm biến Khí áp BMP280 / BME280
        config CUSTOM_ENABLE_SENSOR_BMP280
            bool "Cảm biến Áp suất khí quyển & Độ cao (Bosch BMP280 / BME280 I2C)"
            default n

        # 12. Cảm biến Ánh sáng BH1750
        config CUSTOM_ENABLE_SENSOR_BH1750
            bool "Cảm biến cường độ ánh sáng kỹ thuật số BH1750 (I2C)"
            default n

        # 13. Cảm biến Ánh sáng quang trở LDR (ADC)
        config CUSTOM_ENABLE_SENSOR_LDR
            bool "Cảm biến ánh sáng quang trở (LDR qua cầu phân áp ADC)"
            default n

        config CUSTOM_SENSOR_LDR_ADC_CHANNEL
            int "Kênh ADC1 đo quang trở LDR (Kênh 1 ứng với GPIO 2)"
            depends on CUSTOM_ENABLE_SENSOR_LDR
            default 1

        # 14. Cảm biến Siêu âm HC-SR04
        config CUSTOM_ENABLE_SENSOR_HCSR04
