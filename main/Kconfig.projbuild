        config CUSTOM_SENSOR_DHT_GPIO
            int "Chân dữ liệu 1-Wire cảm biến DHT GPIO"
            depends on CUSTOM_ENABLE_SENSOR_DHT11_22
            default 14

        # 10. Cảm biến Nhiệt độ & Độ ẩm kỹ thuật số I2C AHT20 / SHT3x
        config CUSTOM_ENABLE_SENSOR_I2C_TEMP_HUMID
