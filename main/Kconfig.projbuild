        menuconfig ENABLE_CUSTOM_SECONDARY_NETWORK
            bool "Mạng mở rộng (4G LTE / Ethernet SPI / USB RNDIS)"
            default n
            help
                Cấu hình các module mạng mở rộng ngoài Wi-Fi mặc định của ESP32-S3.

        if ENABLE_CUSTOM_SECONDARY_NETWORK
            choice CUSTOM_NETWORK_TYPE
                prompt "Module Kết Nối Mạng Mở Rộng"
                default CUSTOM_NETWORK_NONE

                config CUSTOM_NETWORK_NONE
                    bool "Chỉ sử dụng Wi-Fi nội bộ của ESP32-S3"
