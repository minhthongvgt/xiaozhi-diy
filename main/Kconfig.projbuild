            range -1 48
            default -1

        config CUSTOM_ENABLE_TOUCH_SLIDER
            bool "Thanh trượt cảm ứng điện dung nội bộ ESP32-S3 (Touch Slider)"
            default n
            help
                Thanh trượt điều khiển cảm ứng điện dung sử dụng 3 kênh Touch pad nội bộ.

        config CUSTOM_TOUCH_SLIDER_PAD1_GPIO
            int "Chân Touch Pad 1 của thanh trượt (GPIO 1-14)"
            depends on CUSTOM_ENABLE_TOUCH_SLIDER
