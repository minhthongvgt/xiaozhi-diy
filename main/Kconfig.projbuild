                range -1 48
                default -1

            config CUSTOM_CAM_PIN_D1
                int "Camera Data D1 Pin"
                depends on !CUSTOM_CAMERA_USB_UVC
                range -1 48
                default -1

            config CUSTOM_CAM_PIN_D2
