        # 2. Đèn LED trạng thái
        menuconfig ENABLE_CUSTOM_LEDS
            bool "Đèn LED trạng thái (Status LED WS2812 / Single LED)"
            default y
            help
                Cấu hình đèn LED trạng thái (WS2812 RGB, Single LED PWM, Circular LED Strip).

        if ENABLE_CUSTOM_LEDS
            choice CUSTOM_LED_TYPE
                prompt "Loại Đèn LED Báo Hiệu Trạng Thái"
                default CUSTOM_LED_WS2812

                config CUSTOM_LED_WS2812
                    bool "Đèn LED RGB kỹ thuật số WS2812 / SK6812 (Giao thức RMT)"
                config CUSTOM_LED_SINGLE_PWM
                    bool "Đèn LED đơn điều chỉnh độ sáng (LEDC PWM)"
                config CUSTOM_LED_CIRCULAR_STRIP
                    bool "Vòng tròn LED xoay trạng thái (Circular LED Strip)"
                config CUSTOM_LED_USER_CUSTOM
                    bool "🔌 Driver Đèn LED tùy chỉnh do người dùng tự viết (Custom User LED Driver Hook)"
                config CUSTOM_LED_NONE
                    bool "Không sử dụng đèn LED"
            endchoice

            config CUSTOM_LED_GPIO
                int "Chân GPIO kết nối Đèn LED (Mặc định chân LED onboard)"
                range -1 48
                default 48


            config CUSTOM_LED_COUNT
                int "Số lượng mắt LED trên dải/vòng (Hỗ trợ tối đa 1024 mắt LED)"
                range 1 1024
                default 1
                help
                    Số lượng mắt LED kỹ thuật số WS2812/SK6812 (từ 1 đến 1024 mắt LED).
                    Khi cấu hình trên 24 mắt LED, hệ thống tự động kích hoạt kênh DMA để đảm bảo khung hình mượt mà và không giật lag.

            config CUSTOM_LED_FAST_RAINBOW_EFFECT
                bool "Hiệu ứng Đổi Màu Cầu Vồng Nhanh (Fast Rainbow Effect khi nói / khởi động)"
                depends on CUSTOM_LED_WS2812 || CUSTOM_LED_CIRCULAR_STRIP
                default y
                help
                    Kích hoạt hiệu ứng LED RGB chuyển màu cầu vồng đa sắc cực nhanh và mượt khi loa phát âm thanh hoặc khi khởi động.
        endif

        endmenu

