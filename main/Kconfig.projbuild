        menu "LED đơn GPIO (chatbot điều khiển)"
            config CUSTOM_LED_EXTRA_GPIOS
                string "Các chân LED đơn (cách nhau dấu phẩy, để trống là không dùng)"
                default ""
                help
                    Mỗi chân là một LED một màu. Chatbot bật/tắt, chỉnh độ sáng và chọn hiệu ứng nháy/thở.
                    Bốn LED đầu dùng PWM (3 nếu LED trạng thái là LED đơn PWM); các LED sau chỉ bật/tắt và nháy.

            config CUSTOM_GPIO_LED_BRIGHTNESS
                int "Độ sáng mặc định (%)"
                range 1 100
                default 100

            choice CUSTOM_GPIO_LED_BOOT_EFFECT
