                depends on !CUSTOM_CAMERA_USB_UVC
                default 13

            config CUSTOM_CAM_PIN_HREF
                int "Camera HREF (Horizontal Reference)"
                depends on !CUSTOM_CAMERA_USB_UVC
                default 14

            config CUSTOM_CAM_PIN_SIOD
