                default 11

            config CUSTOM_ETH_SPI_RST_GPIO
                int "Ethernet SPI Reset (RST) GPIO"
                default 14
        endif

        menuconfig ENABLE_CUSTOM_MCP_SERVER
            bool "Giao thức IoT & Tính năng MCP (Model Context Protocol)"
            default n
            help
                Cung cấp bộ công cụ Tool MCP cho AI Xiaozhi điều khiển phần cứng thông minh.

        if ENABLE_CUSTOM_MCP_SERVER
            config CUSTOM_MCP_TOOL_SYSTEM_INFO
                bool "Cho phép LLM đọc thông số hệ thống (Pin, RAM, Wi-Fi RSSI)"
                default y

            config CUSTOM_MCP_TOOL_REBOOT
                bool "Cho phép LLM ra lệnh khởi động lại bo mạch"
                default y

            config CUSTOM_MCP_TOOL_OTA
                bool "Cho phép LLM kiểm tra và cập nhật Firmware OTA"
                default y

            config CUSTOM_MCP_TOOL_CAMERA
                bool "Cho phép LLM chụp ảnh từ Camera để phân tích thị giác"
                default n

            config CUSTOM_MCP_TOOL_THEME
                bool "Cho phép LLM thay đổi theme giao diện LVGL"
                default n

            config CUSTOM_MCP_TOOL_LAMP
                bool "Cho phép LLM bật/tắt thiết bị ngoại vi qua GPIO (Đèn/Relay)"
                default y

            config CUSTOM_MCP_LAMP_GPIO
                int "Chân GPIO kết nối thiết bị/đèn điều khiển thông minh"
                default 13
        endif
    endmenu

    menu "5. Mở rộng linh kiện ngoại vi & Cảm biến (Peripherals & Sensors)"
        menuconfig ENABLE_CUSTOM_LEDS
            bool "Đèn LED & Động cơ Servo"
            default n
            help
                Cấu hình đèn LED RGB trạng thái và động cơ servo PWM.

        if ENABLE_CUSTOM_LEDS
            choice CUSTOM_LED_TYPE
                prompt "Loại Đèn LED Báo Hiệu Trạng Thái"
                default CUSTOM_LED_WS2812

                config CUSTOM_LED_WS2812
                    bool "Đèn LED RGB kỹ thuật số WS2812 / SK6812 (Giao thức RMT)"
                config CUSTOM_LED_SINGLE_PWM
                    bool "Đèn LED đơn điều chỉnh độ sáng (LEDC PWM)"
                config CUSTOM_LED_CIRCULAR_STRIP
                    bool "Vòng tròn LED xoay trạng thái (Circular LED Strip)"
                config CUSTOM_LED_NONE
                    bool "Không sử dụng đèn LED"
            endchoice

            config CUSTOM_LED_GPIO
                int "Chân GPIO kết nối Đèn LED (Mặc định chân LED onboard)"
                default 48

            config CUSTOM_LED_COUNT
                int "Số lượng mắt LED trên dây"
                default 1

            config CUSTOM_ENABLE_SERVO_DOG
                bool "Kích hoạt điều khiển Động cơ Servo tương tác qua PWM"
                default n
        endif

        menu "Nút bấm vật lý (Buttons & Keys)"
            config CUSTOM_ENABLE_BUTTON_BOOT
                bool "Nút Boot Onboard (BOOT Button - GPIO 0)"
                default y
                help
                    Nút nhấn chuyển đổi trạng thái nói và vào chế độ cấu hình Wi-Fi.

            config CUSTOM_BUTTON_BOOT_GPIO
                int "Chân GPIO nút Boot"
                depends on CUSTOM_ENABLE_BUTTON_BOOT
                default 0

            config CUSTOM_ENABLE_BUTTON_TOUCH
                bool "Nút bấm chức năng PTT / Action (Push-to-Talk)"
                default n
                help
                    Nút nhấn giữ để nói (Push-to-Talk) hoặc nút cảm ứng chạm.

            config CUSTOM_BUTTON_TOUCH_GPIO
                int "Chân GPIO nút Action"
                depends on CUSTOM_ENABLE_BUTTON_TOUCH
                default 1

            config CUSTOM_ENABLE_BUTTON_VOLUME
                bool "Phím vật lý tăng / giảm âm lượng (Volume Buttons)"
                default n
                help
                    Cặp phím bấm điều chỉnh âm lượng loa ngoài.

            config CUSTOM_BUTTON_VOL_UP_GPIO
                int "Chân GPIO nút tăng âm lượng (Vol Up)"
                depends on CUSTOM_ENABLE_BUTTON_VOLUME
                default 2

            config CUSTOM_BUTTON_VOL_DOWN_GPIO
                int "Chân GPIO nút giảm âm lượng (Vol Down)"
                depends on CUSTOM_ENABLE_BUTTON_VOLUME
                default 3
        endmenu

        menu "Rơ-le điều khiển thiết bị (Relay Switches)"
            config CUSTOM_PERIPH_RELAY_ENABLE
                bool "Kích hoạt Relay đóng cắt thiết bị độc lập"
                default n
                help
                    Điều khiển đóng cắt relay hoặc công tắc thiết bị điện ngoài.

            config CUSTOM_PERIPH_RELAY_GPIO
                int "Chân GPIO kích hoạt Relay đóng cắt"
                depends on CUSTOM_PERIPH_RELAY_ENABLE
                default 13
        endmenu

        menuconfig ENABLE_CUSTOM_IO_EXPANDER_PMIC
            bool "Mở rộng chân IO & Quản lý nguồn PMIC"
            default n
            help
                Mở rộng số lượng chân GPIO qua I2C và quản lý sạc nguồn pin PMIC.

        if ENABLE_CUSTOM_IO_EXPANDER_PMIC
            choice CUSTOM_IO_EXPANDER_TYPE
                prompt "IC Mở Rộng Chân GPIO (IO Expander)"
                default CUSTOM_IO_EXPANDER_NONE

                config CUSTOM_IO_EXPANDER_NONE
                    bool "Không sử dụng IC mở rộng chân"
                config CUSTOM_IO_EXPANDER_TCA9554
                    bool "TI TCA9554 / TCA9539 (8-bit / 16-bit I2C IO Expander)"
                config CUSTOM_IO_EXPANDER_CH32V003
                    bool "WCH CH32V003 MCU (I2C IO Expander Firmware)"
            endchoice

            choice CUSTOM_PMIC_TYPE
                prompt "IC Quản Lý Nguồn (PMIC & Charger)"
                default CUSTOM_PMIC_NONE

                config CUSTOM_PMIC_NONE
                    bool "Không sử dụng IC quản lý nguồn"
                config CUSTOM_PMIC_AXP2101
                    bool "X-Powers AXP2101 / AXP192 (I2C PMIC)"
                config CUSTOM_PMIC_SY6970
                    bool "Silergy SY6970 (I2C Battery Fast Charger)"
            endchoice

            config CUSTOM_EXPANDER_I2C_SDA
                int "Chân I2C SDA dùng cho IC Mở Rộng / PMIC"
                default 8

            config CUSTOM_EXPANDER_I2C_SCL
                int "Chân I2C SCL dùng cho IC Mở Rộng / PMIC"
                default 9
        endif

        menuconfig ENABLE_CUSTOM_SENSORS
            bool "Cảm biến môi trường, chuyển động & Pin"
            default n
            help
                Bật/tắt các cảm biến phổ biến (nhiệt ẩm, khí áp, ánh sáng, khoảng cách, IMU) và đo pin.

        if ENABLE_CUSTOM_SENSORS
            # Cảm biến chuyển động & IMU
            config CUSTOM_ENABLE_IMU_MPU6050
                bool "Cảm biến gia tốc & con quay 6 trục MPU-6050 (I2C: SDA 8, SCL 9)"
                default n

            config CUSTOM_ENABLE_IMU_BMI270
                bool "Cảm biến gia tốc & con quay 6 trục Bosch BMI270 (I2C: SDA 8, SCL 9)"
                default n

            # Cảm biến nhiệt độ & độ ẩm
            config CUSTOM_ENABLE_SENSOR_DHT11_22
                bool "Cảm biến nhiệt độ & độ ẩm DHT11 / DHT22 (1-Wire GPIO)"
                default n

            config CUSTOM_SENSOR_DHT_GPIO
                int "Chân dữ liệu cảm biến DHT11/22 GPIO"
                depends on CUSTOM_ENABLE_SENSOR_DHT11_22
                default 14

            config CUSTOM_ENABLE_SENSOR_AHT20
                bool "Cảm biến nhiệt độ & độ ẩm AHT10 / AHT20 / AHT21 (I2C)"
                default n

            config CUSTOM_ENABLE_SENSOR_SHT3X
                bool "Cảm biến nhiệt độ & độ ẩm Sensirion SHT30 / SHT31 / SHT40 (I2C)"
                default n

            # Cảm biến khí áp & độ cao
            config CUSTOM_ENABLE_SENSOR_BMP280
                bool "Cảm biến áp suất khí quyển & độ cao Bosch BMP280 / BME280 (I2C)"
                default n

            # Cảm biến ánh sáng
            config CUSTOM_ENABLE_SENSOR_BH1750
                bool "Cảm biến cường độ ánh sáng kỹ thuật số BH1750 (I2C)"
                default n

            config CUSTOM_ENABLE_SENSOR_LDR
                bool "Cảm biến ánh sáng quang trở (LDR qua cầu phân áp ADC)"
                default n

            config CUSTOM_SENSOR_LDR_ADC_CHANNEL
                int "Kênh ADC1 đo quang trở LDR (Kênh 1 ứng với GPIO 2)"
                depends on CUSTOM_ENABLE_SENSOR_LDR
                default 1

            # Cảm biến khoảng cách & chuyển động người
            config CUSTOM_ENABLE_SENSOR_HCSR04
                bool "Cảm biến khoảng cách siêu âm HC-SR04 / US-100"
                default n

            config CUSTOM_SENSOR_HCSR04_TRIG_GPIO
                int "Chân phát xung siêu âm Trig GPIO"
                depends on CUSTOM_ENABLE_SENSOR_HCSR04
                default 11

            config CUSTOM_SENSOR_HCSR04_ECHO_GPIO
                int "Chân nhận tín hiệu siêu âm Echo GPIO"
                depends on CUSTOM_ENABLE_SENSOR_HCSR04
                default 12

            config CUSTOM_ENABLE_SENSOR_PIR
                bool "Cảm biến phát hiện người chuyển động PIR HC-SR501 / RCWL-0516"
                default n

            config CUSTOM_SENSOR_PIR_GPIO
                int "Chân tín hiệu cảm biến PIR GPIO"
                depends on CUSTOM_ENABLE_SENSOR_PIR
                default 10

            # Cảm ứng điện dung nội bộ
            config CUSTOM_ENABLE_TOUCH_SLIDER
                bool "Thanh trượt cảm ứng điện dung nội bộ ESP32-S3 (Touch Slider)"
                default n

            # Phương thức đo mức pin
            choice CUSTOM_BATTERY_MONITOR_TYPE
                prompt "Phương thức Đo Dung Lượng Pin (Battery Measurement)"
                default CUSTOM_BATTERY_MONITOR_NONE

                config CUSTOM_BATTERY_MONITOR_NONE
                    bool "Không sử dụng (Nguồn điện cắm cố định)"
                config CUSTOM_BATTERY_MONITOR_ADC
                    bool "Đo qua ADC nội bộ (Bộ chia điện trở Voltage Divider)"
                config CUSTOM_BATTERY_MONITOR_BQ27220
                    bool "Đo qua IC đo pin chuyên dụng TI BQ27220 (I2C)"
            endchoice

            config CUSTOM_BATTERY_ADC_CHANNEL
                int "Kênh ADC1 đo pin (Kênh 0 ứng với chân GPIO 1)"
                default 0

            config CUSTOM_BATTERY_DIVIDER_R1
                int "Điện trở nhánh trên R1 cầu phân áp (kOhm)"
                default 100

            config CUSTOM_BATTERY_DIVIDER_R2
                int "Điện trở nhánh dưới R2 cầu phân áp (kOhm)"
                default 100
        endif
    endmenu

endmenu

endmenu
