                config CUSTOM_ENABLE_SENSOR_AHT20
                    bool "Aosong AHT10 / AHT20 / AHT21 (I2C)"
                config CUSTOM_ENABLE_SENSOR_SHT3X
                    bool "Sensirion SHT30 / SHT31 / SHT40 (I2C)"
            endchoice

            config CUSTOM_SENSOR_I2C_SDA
                int "Chân I2C SDA cảm biến môi trường"
                default 8

            config CUSTOM_SENSOR_I2C_SCL
