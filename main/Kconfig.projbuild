            config CUSTOM_AUDIO_MIC_GPIO_SCK
                int "Micro I2S Bit Clock (SCK / BCLK)"
                default 5

            config CUSTOM_AUDIO_MIC_GPIO_DIN
                int "Micro I2S Data Input (DIN / SD)"
                default 6
        endif

        if ENABLE_CUSTOM_SPEAKER || ENABLE_CUSTOM_MIC
            choice CUSTOM_AUDIO_I2S_MODE
                prompt "Chế độ đường xung I2S giữa Loa và Mic"
                default CUSTOM_AUDIO_I2S_SIMPLEX
                help
                    Simplex: Tách riêng xung Clock cho Loa và Mic. Duplex: Dùng chung xung BCLK và WS.

                config CUSTOM_AUDIO_I2S_SIMPLEX
                    bool "Simplex (Tách riêng Clock cho Mic và Loa)"
                config CUSTOM_AUDIO_I2S_DUPLEX
                    bool "Duplex (Dùng chung xung BCLK và WS)"
            endchoice

            config CUSTOM_AUDIO_CODEC_I2C_SDA
                int "Chân Codec I2C SDA (Khi dùng ES8311/ES8388)"
                default 8

            config CUSTOM_AUDIO_CODEC_I2C_SCL
                int "Chân Codec I2C SCL (Khi dùng ES8311/ES8388)"
                default 9
        endif
    endmenu

    menuconfig ENABLE_CUSTOM_CAMERA
        bool "3. Camera & Thị giác AI (Camera DVP / USB UVC)"
        default n
        help
