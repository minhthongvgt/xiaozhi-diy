                depends on CUSTOM_AUDIO_MIC_CODEC_ES8311 || CUSTOM_AUDIO_MIC_CODEC_ES8388 || CUSTOM_AUDIO_MIC_CODEC_ES8374 || CUSTOM_AUDIO_MIC_CODEC_ES8389 || CUSTOM_AUDIO_MIC_CODEC_BOX
                range -1 48
                default -1

        endif

        choice CUSTOM_AUDIO_I2S_MODE
            prompt "Chế Độ Xung Nhịp I2S (I2S Clock Mode)"
            depends on ENABLE_CUSTOM_SPEAKER || ENABLE_CUSTOM_MIC
            default CUSTOM_AUDIO_I2S_SIMPLEX
            help
                Chọn Simplex nếu Loa và Micro chạy trên các kênh xung riêng biệt.
                Chọn Duplex nếu Loa và Micro dùng chung chân BCLK và WS.

            config CUSTOM_AUDIO_I2S_SIMPLEX
                bool "Simplex (Độc lập: Loa và Micro có chân Clock BCLK/WS riêng)"
            config CUSTOM_AUDIO_I2S_DUPLEX
                bool "Duplex (Dùng chung: Loa và Micro chia sẻ chung chân BCLK và WS)"
        endchoice

        config CUSTOM_AUDIO_CODEC_AEC_REFERENCE
            bool "Kênh tham chiếu khử tiếng vọng từ Codec (AEC Hardware Reference)"
            depends on ENABLE_CUSTOM_SPEAKER && ENABLE_CUSTOM_MIC
            depends on ((CUSTOM_AUDIO_SPK_CODEC_ES8388 || CUSTOM_AUDIO_MIC_CODEC_ES8388) && !(CUSTOM_AUDIO_SPK_CODEC_ES8311 || CUSTOM_AUDIO_MIC_CODEC_ES8311)) || ((CUSTOM_AUDIO_SPK_CODEC_BOX || CUSTOM_AUDIO_MIC_CODEC_BOX) && !(CUSTOM_AUDIO_SPK_CODEC_ES8311 || CUSTOM_AUDIO_MIC_CODEC_ES8311 || CUSTOM_AUDIO_SPK_CODEC_ES8388 || CUSTOM_AUDIO_MIC_CODEC_ES8388 || CUSTOM_AUDIO_SPK_CODEC_ES8374 || CUSTOM_AUDIO_MIC_CODEC_ES8374 || CUSTOM_AUDIO_SPK_CODEC_ES8389 || CUSTOM_AUDIO_MIC_CODEC_ES8389))
            default n
            help
                Thu tín hiệu loa đang phát làm kênh tham chiếu "R" cho AEC trên thiết bị.
                Chỉ bật khi mạch thực sự nối tín hiệu DAC ngược về ADC:
                - ES8388: kênh ADC phải (LINPUT2/RINPUT2) nhận tín hiệu loa, micro ở kênh trái.
                - Box (ES8311 + ES7210): MIC3 của ES7210 nối vào đầu ra DAC (như ESP32-S3-BOX).
                Bật sai trên mạch không có đường tham chiếu sẽ làm AEC hoạt động kém hơn tắt.
                Nếu tắt, Device-Side AEC dùng kênh tham chiếu phần mềm (USE_SOFTWARE_AEC_REFERENCE).
    endmenu

    menu "3. Giao thức truyền thông & Mạng (Communication, 4G, Ethernet & MCP)"
        menuconfig ENABLE_CUSTOM_UART
            bool "Cổng UART mở rộng (Serial Communication Port)"
            default n
            help
                Giao tiếp nối tiếp UART cho modem 4G, AI thị giác, Robot hoặc servo.

        if ENABLE_CUSTOM_UART
            choice CUSTOM_UART_PORT_NUM
                prompt "Cổng UART Phần Cứng (Hardware UART Port)"
                default CUSTOM_UART_PORT_1

                config CUSTOM_UART_PORT_1
                    bool "UART1 (Cổng serial phần cứng 1)"
                config CUSTOM_UART_PORT_2
                    bool "UART2 (Cổng serial phần cứng 2)"
            endchoice

            config CUSTOM_UART_PIN_TX
                int "Chân phát UART TX GPIO"
                range -1 48
                default -1

            config CUSTOM_UART_PIN_RX
                int "Chân nhận UART RX GPIO"
                range -1 48
                default -1

            config CUSTOM_UART_BAUDRATE
                int "Tốc độ baud truyền thông (Baudrate)"
                range 9600 3000000
            default 115200

            config CUSTOM_UART_USE_FLOW_CONTROL
                bool "Kích hoạt điều khiển luồng phần cứng (RTS/CTS Hardware Flow Control)"
                default n

            config CUSTOM_UART_PIN_RTS
                int "Chân RTS GPIO (Request to Send)"
                depends on CUSTOM_UART_USE_FLOW_CONTROL
                range -1 48
            default -1

            config CUSTOM_UART_PIN_CTS
                int "Chân CTS GPIO (Clear to Send)"
                depends on CUSTOM_UART_USE_FLOW_CONTROL
                range -1 48
            default -1
        endif

        menuconfig ENABLE_BT_UART_MODULE
            bool "Module Bluetooth UART không dây (HC-05 / HC-06 / HM-10)"
            default n
            help
                Module Bluetooth rời nối vào một cổng UART riêng, làm cầu UART không dây trong suốt
                tới một vi điều khiển hoặc module Bluetooth khác.
                Dùng cổng UART riêng, khác cổng UART mở rộng và cổng màn hình rời có dây.

        if ENABLE_BT_UART_MODULE
            choice BT_UART_MODULE_TYPE
                prompt "Loại module Bluetooth"
                default BT_UART_MODULE_HC05
                help
                    Quyết định bộ lệnh AT dùng để cấu hình module khi khởi động.

                config BT_UART_MODULE_HC05
                    bool "HC-05 (Bluetooth Classic SPP, chủ/tớ, cần chân KEY để vào AT)"
                config BT_UART_MODULE_HC06
                    bool "HC-06 / linvor (Bluetooth Classic SPP, chỉ làm tớ)"
                config BT_UART_MODULE_HM10
                    bool "HM-10 / CC2541 (BLE, chủ/tớ)"
                config BT_UART_MODULE_PRECONFIGURED
                    bool "Module đã cấu hình sẵn (không gửi lệnh AT)"
            endchoice

            choice BT_UART_MODULE_PORT
                prompt "Cổng UART phần cứng cho module Bluetooth"
                default BT_UART_MODULE_PORT_2
                help
                    Phải khác cổng của UART mở rộng và của màn hình rời có dây.

                config BT_UART_MODULE_PORT_1
                    bool "UART1"
                config BT_UART_MODULE_PORT_2
                    bool "UART2"
            endchoice

            config BT_UART_MODULE_TX_PIN
                int "Chân TX (nối chân RXD của module)"
                range -1 48
                default -1

            config BT_UART_MODULE_RX_PIN
                int "Chân RX (nối chân TXD của module)"
                range -1 48
                default -1

            config BT_UART_MODULE_BAUDRATE
                int "Tốc độ baud dữ liệu của module"
                range 1200 1382400
                default 9600
                help
                    HC-05, HC-06 và HM-10 xuất xưởng ở 9600 baud. Hai module ghép đôi có thể chạy baud khác nhau.

            config BT_UART_MODULE_STATE_PIN
                int "Chân STATE / LED (biết đã kết nối, -1 nếu không nối)"
                range -1 48
                default -1
                help
                    Mức cao khi module đang kết nối (HC-05 STATE, HM-10 chân LED ở chế độ AT+PIO11).

            config BT_UART_MODULE_KEY_PIN
                int "Chân KEY / EN của HC-05 (-1 nếu không nối)"
                depends on BT_UART_MODULE_HC05
                range -1 48
                default -1
                help
                    Kéo lên mức cao để gửi lệnh AT. Thiếu chân này thì không cấu hình được HC-05 từ firmware.

            config BT_UART_MODULE_APPLY_SETTINGS
                bool "Gửi lệnh AT đặt tên, mã PIN và vai trò khi khởi động"
                depends on !BT_UART_MODULE_PRECONFIGURED
                default n
                help
                    Chỉ gửi lệnh khi module chưa kết nối. Tắt nếu đã cấu hình module bằng công cụ khác.

            config BT_UART_MODULE_NAME
                string "Tên Bluetooth của module"
                depends on BT_UART_MODULE_APPLY_SETTINGS
                default "Xiaozhi-BT"

            config BT_UART_MODULE_PIN_CODE
                string "Mã PIN ghép đôi (HC-05/HC-06: 4 số, HM-10: 6 số, để trống = giữ nguyên)"
                depends on BT_UART_MODULE_APPLY_SETTINGS
                default ""

            choice BT_UART_MODULE_ROLE
                prompt "Vai trò của module"
                depends on BT_UART_MODULE_APPLY_SETTINGS && (BT_UART_MODULE_HC05 || BT_UART_MODULE_HM10)
                default BT_UART_MODULE_ROLE_SLAVE
                help
                    Tớ: chờ thiết bị khác kết nối. Chủ: tự kết nối tới module ở đầu kia theo địa chỉ.

                config BT_UART_MODULE_ROLE_SLAVE
                    bool "Tớ (Slave)"
                config BT_UART_MODULE_ROLE_MASTER
                    bool "Chủ (Master), tự kết nối tới địa chỉ cố định"
            endchoice

            config BT_UART_MODULE_REMOTE_ADDR
                string "Địa chỉ Bluetooth của module đầu kia (12 chữ số hex)"
                depends on BT_UART_MODULE_ROLE_MASTER
                default ""
                help
                    Ví dụ 98D331F5B9E7 hoặc 98:D3:31:F5:B9:E7. Đọc bằng lệnh AT+ADDR? trên module đầu kia.

            choice BT_UART_MODULE_FRAME
                prompt "Định dạng gói dữ liệu"
                depends on !CUSTOM_DISPLAY_UART_LINK_BLUETOOTH
                default BT_UART_MODULE_FRAME_LINE
                help
                    Cách chia luồng byte thành từng gói khi gửi và nhận qua công cụ MCP.

                config BT_UART_MODULE_FRAME_RAW
                    bool "Thô (gửi nguyên văn, nhận theo khoảng nghỉ)"
                config BT_UART_MODULE_FRAME_LINE
                    bool "Dòng văn bản (kết thúc bằng ký tự xuống dòng LF)"
                config BT_UART_MODULE_FRAME_BINARY4
                    bool "Khung nhị phân 4 byte (0xAA, chục, đơn vị, XOR)"
            endchoice
        endif

        config CUSTOM_MCP_TOOL_LAMP
            bool "Đèn điều khiển bằng AI qua GPIO (MCP)"
            default n
            help
                Mỗi chân đèn tạo một bộ công cụ MCP riêng (self.lamp hoặc self.lamp_1, self.lamp_2...).
                Các công cụ MCP khác tự bật theo phần cứng được chọn ở mục 4, không cần bật tay.
                Relay 220V được điều khiển qua nhóm Cơ cấu chấp hành.

        config CUSTOM_MCP_TOOL_LAMP_GPIO
            int "Chân GPIO điều khiển Đèn"
            depends on CUSTOM_MCP_TOOL_LAMP
            range -1 48
            default -1

        config CUSTOM_MCP_TOOL_LAMP_EXTRA_GPIOS
            string "Các chân GPIO Đèn thêm (cách nhau dấu phẩy)"
            depends on CUSTOM_MCP_TOOL_LAMP
            default ""

        config CUSTOM_MCP_TOOL_SENSOR
            bool
            default y if CUSTOM_ENABLE_SENSOR_DHT11_22 || CUSTOM_ENABLE_SENSOR_AHT20 || CUSTOM_ENABLE_SENSOR_BMP280 || CUSTOM_ENABLE_SENSOR_BH1750 || CUSTOM_ENABLE_SENSOR_LDR || CUSTOM_SENSOR_GAS_SCD4X || CUSTOM_ENABLE_SENSOR_GAS_ANALOG_MQ || CUSTOM_ENABLE_SENSOR_APDS9960 || CUSTOM_ENABLE_SENSOR_VL53LX || CUSTOM_ENABLE_SENSOR_HCSR04 || CUSTOM_ENABLE_SENSOR_PIR || CUSTOM_ENABLE_SENSOR_VIBRATION_SW420 || CUSTOM_ENABLE_SENSOR_FLAME || CUSTOM_ENABLE_SENSOR_INA2XX || CUSTOM_ENABLE_PERIPH_BATTERY_CHARGING_DETECT || CUSTOM_BATTERY_MONITOR_BQ27220

        config CUSTOM_MCP_TOOL_ACTUATOR
            bool
            default y if CUSTOM_PERIPH_RELAY_ENABLE || CUSTOM_ENABLE_SERVO_DOG || CUSTOM_ENABLE_PERIPH_MOTOR_DC_HBRIDGE || ENABLE_BUZZER || ENABLE_HAPTIC_MOTOR

        config CUSTOM_MCP_TOOL_ROBOT
            bool
            default y if CUSTOM_ENABLE_PERIPH_MOTOR_DC_HBRIDGE || CUSTOM_ENABLE_SERVO_DOG

        config CUSTOM_MCP_TOOL_LED
            bool
            default y if ENABLE_CUSTOM_LEDS && !CUSTOM_LED_NONE

        config CUSTOM_MCP_TOOL_GPIO_LED
            bool
            default y if CUSTOM_LED_EXTRA_GPIOS != ""

        config CUSTOM_MCP_TOOL_PERIPH
            bool
            default y if CUSTOM_ENABLE_PERIPH_RTC || CUSTOM_ENABLE_PERIPH_NFC_PN532 || CUSTOM_ENABLE_PERIPH_PCA9685 || CUSTOM_ENABLE_PERIPH_LED_DRIVER_IC || CUSTOM_PERIPH_RC522_SPI_CS >= 0 || CUSTOM_IMU_I2C_SDA >= 0 || CUSTOM_PMIC_I2C_SDA >= 0 || CUSTOM_EXPANDER_I2C_SDA >= 0 || CUSTOM_ETH_SPI_CS_PIN >= 0

        config CUSTOM_MCP_TOOL_PRESS_TO_TALK
            bool
            default y if CUSTOM_ENABLE_BUTTON_BOOT || CUSTOM_ENABLE_BUTTON_TOUCH

        config CUSTOM_MCP_TOOL_UART
            bool
            default y if ENABLE_CUSTOM_UART && CUSTOM_UART_PIN_TX >= 0

        config CUSTOM_MCP_TOOL_BT_UART
            bool
            default y if ENABLE_BT_UART_MODULE && !CUSTOM_DISPLAY_UART_LINK_BLUETOOTH

        config ENABLE_CUSTOM_MCP_SERVER
            bool
            default y if CUSTOM_MCP_TOOL_LAMP || CUSTOM_MCP_TOOL_SENSOR || CUSTOM_MCP_TOOL_ACTUATOR || CUSTOM_MCP_TOOL_ROBOT || CUSTOM_MCP_TOOL_LED || CUSTOM_MCP_TOOL_GPIO_LED || CUSTOM_MCP_TOOL_PERIPH || CUSTOM_MCP_TOOL_PRESS_TO_TALK || CUSTOM_MCP_TOOL_UART || CUSTOM_MCP_TOOL_BT_UART
    endmenu

    menu "4. Thiết bị ngoại vi & 7 Nhóm Phần Cứng (Hardware Builder)"
        menu "4.1. Tương Tác & Điều Khiển Đầu Vào (User Inputs)"
        config CUSTOM_ENABLE_BUTTON_BOOT
            bool "Nút bấm BOOT Onboard (BOOT Button)"
            default y
            help
                Nút nhấn chuyển đổi trạng thái nói và vào chế độ cấu hình Wi-Fi.

        config CUSTOM_BUTTON_BOOT_GPIO
            int "Chân GPIO nút Boot"
            depends on CUSTOM_ENABLE_BUTTON_BOOT
            range -1 48
            default 0

        config CUSTOM_BUTTON_BOOT_EXTRA_GPIOS
            string "Các chân GPIO nút Boot thêm (cách nhau dấu phẩy)"
            depends on CUSTOM_ENABLE_BUTTON_BOOT
            default ""

        config CUSTOM_ENABLE_BUTTON_TOUCH
            bool "Nút bấm chức năng Action / Chạm (PTT / Touch Key)"
            default n
            help
                Nút nhấn giữ để nói (Push-to-Talk) hoặc nút cảm ứng chạm.

        config CUSTOM_BUTTON_TOUCH_GPIO
            int "Chân GPIO nút Action"
            depends on CUSTOM_ENABLE_BUTTON_TOUCH
