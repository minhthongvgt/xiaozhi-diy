choice DISPLAY_ESP32S3_TOUCH_LCD_1_85C
    depends on BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_85C
    prompt "ESP32S3_TOUCH_LCD_1_85C version"
    default VERSION_2_0
    help
        hardware version
    config VERSION_1_0
        bool "version 1.0"
    config VERSION_2_0
        bool "version 2.0"
endchoice


choice DISPLAY_STYLE
    prompt "Select display style"
    default USE_DEFAULT_MESSAGE_STYLE
    help
        Select display style for Xiaozhi device

    config USE_DEFAULT_MESSAGE_STYLE
        bool "Enable default message style"

    config USE_WECHAT_MESSAGE_STYLE
        bool "Enable WeChat Message Style"

    config USE_EMOTE_MESSAGE_STYLE
        bool "Emote animation style"
        depends on BOARD_TYPE_ESP32_S3_BOX || BOARD_TYPE_ESP32_S3_BOX_3 \
            || BOARD_TYPE_ESP_VOCAT || BOARD_TYPE_LICHUANG_DEV_S3 || BOARD_TYPE_RYMCU_BIGSMART \
            || BOARD_TYPE_ESP_SENSAIRSHUTTLE
endchoice

config USE_MULTILINE_CHAT_MESSAGE
    bool "Use multiline chat message display (default mode only)"
    depends on USE_DEFAULT_MESSAGE_STYLE
    default n
    help
        When enabled, the chat message area in the default display mode shows
        multiple wrapped lines that grow upward from the bottom of the screen,
        with auto-adaptive height.
        When disabled (default), a single-line horizontally scrolling label
        is shown at the bottom of the screen.

choice WAKE_WORD_TYPE
    prompt "Wake Word Implementation Type"
    default USE_AFE_WAKE_WORD if (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
    default WAKE_WORD_DISABLED
    help
        Choose the type of wake word implementation to use

    config WAKE_WORD_DISABLED
        bool "Disabled"
        help
            Disable wake word detection

    config USE_ESP_WAKE_WORD
        bool "Wakenet model without AFE"
        depends on IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C5 || IDF_TARGET_ESP32C6 || (IDF_TARGET_ESP32 && SPIRAM)
        help
            Support ESP32 C3、ESP32 C5 与 ESP32 C6, and (ESP32 with PSRAM)

    config USE_AFE_WAKE_WORD
        bool "Wakenet model with AFE"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
        help
            Support AEC if available, requires ESP32-S3, ESP32-P4, or ESP32-S31 and PSRAM

    config USE_CUSTOM_WAKE_WORD
        bool "Multinet model (Custom Wake Word)"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
        help
            Requires ESP32-S3, ESP32-P4, or ESP32-S31 and PSRAM

endchoice

config CUSTOM_WAKE_WORD
    string "Custom Wake Word"
    default "xiao tu dou"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word, use pinyin for Chinese, separated by spaces

config CUSTOM_WAKE_WORD_DISPLAY
    string "Custom Wake Word Display"
    default "小土豆"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Greeting sent to the server after wake word detection

config CUSTOM_WAKE_WORD_THRESHOLD
    int "Custom Wake Word Threshold (%)"
    default 20
    range 1 99
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word Threshold, range 1-99, the smaller the more sensitive, default 20

config SEND_WAKE_WORD_DATA
    bool "Send Wake Word Data"
    default y
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Send wake word data to the server as the first message of the conversation and wait for response

config WAKE_WORD_DETECTION_IN_LISTENING
    bool "Enable Wake Word Detection in Listening Mode"
    default n
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Enable wake word detection while in listening mode.
        When enabled, the device can detect wake word during listening,
        which allows interrupting the current conversation.
        When disabled (default), wake word detection is turned off during listening.

config USE_AUDIO_PROCESSOR
    bool "Enable AFE Audio Processing"
    default y
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
    help
        Enable the shared AFE uplink path with AEC and VAD. Noise suppression
        is not enabled because this project does not provide an NSNet model.
        Requires ESP32-S3, ESP32-P4, or ESP32-S31 with PSRAM.

config USE_DEVICE_AEC
    bool "Enable Device-Side AEC"
    default n
        depends on USE_AUDIO_PROCESSOR && (BOARD_TYPE_ESP32_S3_BOX_3 || BOARD_TYPE_ESP32_S3_BOX || BOARD_TYPE_ESP32_S3_BOX_LITE \
        || BOARD_TYPE_LICHUANG_DEV_S3 || BOARD_TYPE_RYMCU_BIGSMART || BOARD_TYPE_ESP32_S3_KORVO_2_V3 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_75|| BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_75C || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_83\
        || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_2_06 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4_3 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_5 \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_7B \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_3_4C || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4C || BOARD_TYPE_ESP32_S3_LCD_EV_BOARD_2 || BOARD_TYPE_YUNLIAO_S3 \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_7 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_8 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_10_1 \
        || BOARD_TYPE_ESP_VOCAT || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_3_49 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_3_49_V2 || BOARD_TYPE_WAVESHARE_ESP32_S3_RLCD_4_2 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_85B || BOARD_TYPE_ZHENGCHEN_CAM || BOARD_TYPE_ZHENGCHEN_CAM_ML307 \
        || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_4_3C || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_54 || BOARD_TYPE_WAVESHARE_ESP32_S3_LCD_0_85 || BOARD_TYPE_AI_VOX3 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_43C || BOARD_TYPE_ATK_DNESP32S3_BOX3)
    help
        To work properly, device-side AEC requires a clean output reference path from the speaker signal and physical acoustic isolation between the microphone and speaker.

config USE_SERVER_AEC
    bool "Enable Server-Side AEC (Unstable)"
    default n
    depends on USE_AUDIO_PROCESSOR
    help
        To work perperly, server-side AEC requires server support

config USE_AUDIO_DEBUGGER
    bool "Enable Audio Debugger"
    default n
    help
        Enable audio debugger, send audio data through UDP to the host machine

menu "WiFi Configuration Method"
    help
        WiFi Configuration Method Selection
    config USE_HOTSPOT_WIFI_PROVISIONING
        bool "Hotspot"
        default y
        help
            Use WiFi Hotspot to transmit WiFi configuration data
    config USE_ESP_BLUFI_WIFI_PROVISIONING
        bool "ESP-BluFi"
        select BT_ENABLED
        select BT_BLE_42_FEATURES_SUPPORTED
        select BT_BLE_BLUFI_ENABLE
        help
            Use the PSA Crypto based BluFi security protocol adopted by ESP-IDF 6.
            The provisioning client must support ffdhe3072, SHA-256, and AES-CTR.
endmenu

config AUDIO_DEBUG_UDP_SERVER
    string "Audio Debug UDP Server Address"
    default "192.168.2.100:8000"
    depends on USE_AUDIO_DEBUGGER
    help
        UDP server address, format: IP:PORT, used to receive audio debugging data

config RECEIVE_CUSTOM_MESSAGE
    bool "Enable Custom Message Reception"
    default n
    help
        Enable custom message reception, allow the device to receive custom messages from the server (preferably through the MQTT protocol)

menu "Camera Configuration"
    depends on !IDF_TARGET_ESP32

    comment "Warning: Please read the help text before modifying these settings."

    config XIAOZHI_CAMERA_MIRROR_CONFIGURED
        bool "Override camera mirror settings"
        default n
        help
            When enabled, the common camera implementations apply the
            horizontal and vertical mirror settings below after the sensor has
            been initialized. Parameterized builds enable this automatically
            when either mirror setting is configured.

    config XIAOZHI_CAMERA_HMIRROR
        bool "Mirror Camera Horizontally"
        default n
        depends on XIAOZHI_CAMERA_MIRROR_CONFIGURED
        help
            Flip the captured camera image across the vertical axis.

    config XIAOZHI_CAMERA_VFLIP
        bool "Mirror Camera Vertically"
        default n
        depends on XIAOZHI_CAMERA_MIRROR_CONFIGURED
        help
            Flip the captured camera image across the horizontal axis.

    config XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        bool "Allow JPEG Input"
        default n
        help
            Allow JPEG Input format for the camera.

            This option may need to be enabled when using a USB camera.

            Not currently supported when used simultaneously with XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE.

    config XIAOZHI_ENABLE_HARDWARE_JPEG_ENCODER
        bool "Enable Hardware JPEG Encoder"
        default y
        depends on SOC_JPEG_ENCODE_SUPPORTED
        help
            Use hardware JPEG encoder on ESP32-P4 to encode image to JPEG.
            See https://docs.espressif.com/projects/esp-idf/en/stable/esp32p4/api-reference/peripherals/jpeg.html for more details.

    config XIAOZHI_ENABLE_HARDWARE_JPEG_DECODER
        bool "Enable Hardware JPEG Decoder"
        default n
        depends on SOC_JPEG_DECODE_SUPPORTED && XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        help
            Use hardware JPEG decoder on ESP32-P4 to decode JPEG to image.
            See https://docs.espressif.com/projects/esp-idf/en/stable/esp32p4/api-reference/peripherals/jpeg.html for more details.

    config XIAOZHI_ENABLE_CAMERA_DEBUG_MODE
        bool "Enable Camera Debug Mode"
        default n
        help
            Enable camera debug mode, print camera debug information to the console.
            Only works on boards that support camera.

    config XIAOZHI_ENABLE_CAMERA_ENDIANNESS_SWAP
        bool "Enable software camera buffer endianness swapping"
        default n
        depends on !CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER
        help
            This option treats the camera buffer as a uint16_t[] array and performs byte-swapping (endianness conversion) on each element.

            Should only be modified by development board integration engineers.

            **Incorrect usage may result in incorrect image colors!**

            ATTENTION: If the option CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER is available for your sensor, please use that instead.

    menuconfig XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
        bool "Enable Camera Image Rotation"
        default n
        depends on !XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        help
            Enable camera image rotation, rotate the camera image to the correct orientation.
            - On ESP32-P4, rotation is handled by PPA hardware.
            - On other chips, rotation is done in software with performance cost.
            - For 180° rotation, use HFlip + VFlip instead of this option.

            Not currently supported when used simultaneously with XIAOZHI_CAMERA_ALLOW_JPEG_INPUT.

    if XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
        choice XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE
            prompt "Camera Image Rotation Angle (clockwise)"
            default XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_90
            help
                Camera image rotation angle.
            config XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_90
                bool "90°"
            config XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_270
                bool "270°"
            comment "For 180° rotation, use HFlip + VFlip instead of this option"
        endchoice
    endif
endmenu

menu "TAIJIPAI_S3_CONFIG"
    depends on BOARD_TYPE_TAIJI_PI_S3
    choice I2S_TYPE_TAIJIPI_S3
        prompt "taiji-pi-S3 I2S Type"
        default TAIJIPAI_I2S_TYPE_STD
        help
            I2S 类型选择
        config TAIJIPAI_I2S_TYPE_STD
            bool "I2S Type STD"
        config TAIJIPAI_I2S_TYPE_PDM
            bool "I2S Type PDM"
    endchoice

    config I2S_USE_2SLOT
    bool "Enable I2S 2 Slot"
    default y
    help
        启动双声道
endmenu


menu "Tùy chỉnh (Custom Settings - Dành riêng cho ESP32-S3 N16R8)"
    depends on BOARD_TYPE_ESP32_S3_N16R8_CUSTOM
    help
        Cấu hình toàn diện phần cứng bo mạch ESP32-S3 N16R8 (16MB Flash, 8MB Octal PSRAM).

    menu "0. Thiết lập nhanh (Quick Setup & Hardware Presets)"
        config CUSTOM_PRESET_N16R8_DIY_ENABLED
            bool "Sử dụng Preset Chuẩn N16R8 DIY (Màn hình ST7796, Loa MAX98357A, Micro INMP441, LED WS2812, Boot Button GPIO 0)"
            default n
            imply ENABLE_CUSTOM_DISPLAY
            imply ENABLE_CUSTOM_SPEAKER
            imply ENABLE_CUSTOM_MIC
            imply ENABLE_CUSTOM_LEDS
            imply CUSTOM_ENABLE_BUTTON_BOOT
            help
                Kích hoạt cấu hình phần cứng chuẩn và phổ biến nhất cho bo mạch ESP32-S3 N16R8:
                - Màn hình SPI ST7796 (320x480, MOSI: 47, CLK: 21, CS: 41, DC: 40, RST: 42, BLK: 38)
                - Mạch công suất Loa I2S DAC MAX98357A Mono 3W (DOUT: 7, BCLK: 15, LRCK: 16)
                - Micro thu âm MEMS I2S INMP441 (WS: 4, SCK: 5, DIN: 6)
                - Đèn LED trạng thái RGB WS2812 (GPIO 48)
                - Nút bấm BOOT Onboard (GPIO 0)
                Sau khi bật, bạn vẫn có thể vào các Menu 1-4 để tinh chỉnh sâu nếu cần.
    endmenu

    menu "1. Màn hình & Cảm ứng (Display & Touch Screen)"
        menuconfig ENABLE_CUSTOM_DISPLAY
            bool "Màn hình hiển thị (Display Panel)"
            default n
            help
                Bật/tắt trình điều khiển màn hình (SPI LCD, OLED I2C, QSPI AMOLED).

        if ENABLE_CUSTOM_DISPLAY
            choice CUSTOM_DISPLAY_TYPE
                prompt "Loại Bộ Điều Khiển Màn Hình (Display Controller)"
                default CUSTOM_DISPLAY_ST7789 if !CUSTOM_PRESET_N16R8_DIY_ENABLED
                default CUSTOM_DISPLAY_ST7796 if CUSTOM_PRESET_N16R8_DIY_ENABLED

                config CUSTOM_DISPLAY_ST7789
                    bool "Sitronix ST7789 (240x320, 240x240, 170x320 SPI)"
                config CUSTOM_DISPLAY_ST7796
                    bool "Sitronix ST7796 (320x480 SPI)"
                config CUSTOM_DISPLAY_ST7701
                    bool "Sitronix ST7701 (RGB Interface)"
                config CUSTOM_DISPLAY_ILI9341
                    bool "Ilitek ILI9341 (240x320 SPI)"
                config CUSTOM_DISPLAY_GC9A01
                    bool "GalaxyCore GC9A01 (240x240 Màn hình tròn SPI)"
                config CUSTOM_DISPLAY_OLED_SSD1306
                    bool "Solomon OLED SSD1306 (128x64 / 128x32 I2C)"
                config CUSTOM_DISPLAY_OLED_SH1106
                    bool "Sino Wealth OLED SH1106 (128x64 I2C)"
                config CUSTOM_DISPLAY_QSPI_AMOLED
                    bool "AMOLED QSPI (SH8601 / CO5300 / SPD2010)"
                config CUSTOM_DISPLAY_NONE
                    bool "Không sử dụng màn hình (Audio Only / Headless)"
            endchoice

            config CUSTOM_DISPLAY_WIDTH
                int "Độ phân giải ngang (Width Pixels)"
                default 240

            config CUSTOM_DISPLAY_HEIGHT
                int "Độ phân giải dọc (Height Pixels)"
                default 320

            config CUSTOM_DISPLAY_PIN_MOSI
                int "Chân dữ liệu SPI MOSI (SDA)"
                default 47

            config CUSTOM_DISPLAY_PIN_CLK
                int "Chân xung nhịp SPI CLK (SCL)"
                default 21

            config CUSTOM_DISPLAY_PIN_CS
                int "Chân chọn chip SPI CS (-1 nếu không dùng)"
                default 41

            config CUSTOM_DISPLAY_PIN_DC
                int "Chân lệnh/dữ liệu SPI DC"
                default 40

            config CUSTOM_DISPLAY_USE_RST
                bool "Sử dụng chân Reset màn hình (RST)"
                default y

            config CUSTOM_DISPLAY_PIN_RST
                int "Chân Reset màn hình RST GPIO"
                depends on CUSTOM_DISPLAY_USE_RST
                default 42

            config CUSTOM_DISPLAY_USE_BLK
                bool "Điều khiển đèn nền màn hình (Backlight BLK)"
                default y

            config CUSTOM_DISPLAY_PIN_BLK
                int "Chân đèn nền BLK GPIO"
                depends on CUSTOM_DISPLAY_USE_BLK
                default 38

            config CUSTOM_DISPLAY_PIN_I2C_SDA
                int "Chân OLED I2C SDA"
                depends on CUSTOM_DISPLAY_OLED_SSD1306 || CUSTOM_DISPLAY_OLED_SH1106
                default 8

            config CUSTOM_DISPLAY_PIN_I2C_SCL
                int "Chân OLED I2C SCL"
                depends on CUSTOM_DISPLAY_OLED_SSD1306 || CUSTOM_DISPLAY_OLED_SH1106
                default 9

            config CUSTOM_DISPLAY_QSPI_CS
                int "Chân AMOLED QSPI CS"
                depends on CUSTOM_DISPLAY_QSPI_AMOLED
                default 10

            config CUSTOM_DISPLAY_QSPI_CLK
                int "Chân AMOLED QSPI CLK"
                depends on CUSTOM_DISPLAY_QSPI_AMOLED
                default 15

            config CUSTOM_DISPLAY_QSPI_D0
                int "Chân AMOLED QSPI D0"
                depends on CUSTOM_DISPLAY_QSPI_AMOLED
                default 11

            config CUSTOM_DISPLAY_QSPI_D1
                int "Chân AMOLED QSPI D1"
                depends on CUSTOM_DISPLAY_QSPI_AMOLED
                default 12

            config CUSTOM_DISPLAY_QSPI_D2
                int "Chân AMOLED QSPI D2"
                depends on CUSTOM_DISPLAY_QSPI_AMOLED
                default 13

            config CUSTOM_DISPLAY_QSPI_D3
                int "Chân AMOLED QSPI D3"
                depends on CUSTOM_DISPLAY_QSPI_AMOLED
                default 14

            config CUSTOM_DISPLAY_QSPI_RST
                int "Chân AMOLED QSPI Reset"
                depends on CUSTOM_DISPLAY_QSPI_AMOLED
                default 16

            config CUSTOM_DISPLAY_OFFSET_X
                int "Dịch tọa độ X (Offset X Pixels)"
                default 0

            config CUSTOM_DISPLAY_OFFSET_Y
                int "Dịch tọa độ Y (Offset Y Pixels)"
                default 0

            config CUSTOM_DISPLAY_MIRROR_X
                bool "Đảo chiều gương trục X (Mirror X)"
                default n

            config CUSTOM_DISPLAY_MIRROR_Y
                bool "Đảo chiều gương trục Y (Mirror Y)"
                default n

            config CUSTOM_DISPLAY_SWAP_XY
                bool "Hoán đổi tọa độ X-Y (X/Y Axes Swapped)"
                default n

            config CUSTOM_DISPLAY_INVERT_COLOR
                bool "Đảo ngược màu sắc hiển thị (Invert Color)"
                default y
        endif

        menuconfig ENABLE_CUSTOM_TOUCH
            bool "Màn hình cảm ứng (Touch Screen Panel)"
            default n
            help
                Bật/tắt IC cảm ứng điện dung qua giao tiếp I2C.

        if ENABLE_CUSTOM_TOUCH
            choice CUSTOM_TOUCH_TYPE
                prompt "Loại IC Cảm Ứng (Touch Controller)"
                default CUSTOM_TOUCH_CST816S

                config CUSTOM_TOUCH_CST816S
                    bool "Hynitron CST816S / CST9217 (I2C)"
                config CUSTOM_TOUCH_GT911
                    bool "Goodix GT911 / GT1151 (I2C)"
                config CUSTOM_TOUCH_FT5X06
                    bool "FocalTech FT5x06 / FT6336 (I2C)"
                config CUSTOM_TOUCH_NONE
                    bool "Không sử dụng cảm ứng"
            endchoice

            config CUSTOM_TOUCH_PIN_SDA
                int "Chân cảm ứng I2C SDA"
                default 8

            config CUSTOM_TOUCH_PIN_SCL
                int "Chân cảm ứng I2C SCL"
                default 9

            config CUSTOM_TOUCH_PIN_INT
                int "Chân ngắt cảm ứng INT GPIO"
                default 3

            config CUSTOM_TOUCH_PIN_RST
                int "Chân reset cảm ứng RST GPIO (-1 nếu không nối)"
                default 2

            config CUSTOM_TOUCH_SWAP_XY
                bool "Hoán đổi tọa độ cảm ứng X-Y"
                default n

            config CUSTOM_TOUCH_MIRROR_X
                bool "Đảo chiều cảm ứng trục X"
                default n

            config CUSTOM_TOUCH_MIRROR_Y
                bool "Đảo chiều cảm ứng trục Y"
                default n
        endif
    endmenu

    menu "2. Âm thanh: Loa & Micro (Audio: Speaker & Microphone)"
        menuconfig ENABLE_CUSTOM_SPEAKER
            bool "Loa phát thanh & Mạch DAC (Speaker & Audio Out)"
            default n
            help
                Cấu hình xuất âm thanh qua Loa và mạch giải mã I2S DAC.

        if ENABLE_CUSTOM_SPEAKER
            choice CUSTOM_AUDIO_SPEAKER_TYPE
                prompt "Loại Mạch DAC / Loa (Audio DAC / Amplifier)"
                default CUSTOM_AUDIO_DAC_MAX98357A

                config CUSTOM_AUDIO_DAC_MAX98357A
                    bool "MAX98357A (Mạch công suất I2S Class-D Mono 3W)"
                config CUSTOM_AUDIO_DAC_PCM5102A
                    bool "PCM5102A (Mạch giải mã Hi-Fi I2S Stereo DAC 32-bit/384kHz)"
                config CUSTOM_AUDIO_SPK_CODEC_ES8311
                    bool "Everest Semi ES8311 Codec (I2C)"
                config CUSTOM_AUDIO_SPK_CODEC_ES8388
                    bool "Everest Semi ES8388 Stereo Codec (I2C)"
                config CUSTOM_AUDIO_SPK_CODEC_ES8374
                    bool "Everest Semi ES8374 Codec"
                config CUSTOM_AUDIO_SPK_CODEC_ES8389
                    bool "Everest Semi ES8389 Codec"
                config CUSTOM_AUDIO_SPK_CODEC_BOX
                    bool "Box Audio Codec"
            endchoice

            config CUSTOM_AUDIO_SPK_GPIO_DOUT
                int "Chân dữ liệu Loa I2S DOUT (DIN trên module)"
                default 7

            config CUSTOM_AUDIO_SPK_GPIO_BCLK
                int "Chân xung nhịp Loa I2S BCLK (BCK)"
                default 15

            config CUSTOM_AUDIO_SPK_GPIO_LRCK
                int "Chân xung nhịp Loa I2S LRCK / WS (LCK)"
                default 16

            config CUSTOM_AUDIO_SPK_CODEC_I2C_SDA
                int "Chân Codec DAC I2C SDA"
                depends on CUSTOM_AUDIO_SPK_CODEC_ES8311 || CUSTOM_AUDIO_SPK_CODEC_ES8388 || CUSTOM_AUDIO_SPK_CODEC_ES8374 || CUSTOM_AUDIO_SPK_CODEC_ES8389 || CUSTOM_AUDIO_SPK_CODEC_BOX
                default 8

            config CUSTOM_AUDIO_SPK_CODEC_I2C_SCL
                int "Chân Codec DAC I2C SCL"
                depends on CUSTOM_AUDIO_SPK_CODEC_ES8311 || CUSTOM_AUDIO_SPK_CODEC_ES8388 || CUSTOM_AUDIO_SPK_CODEC_ES8374 || CUSTOM_AUDIO_SPK_CODEC_ES8389 || CUSTOM_AUDIO_SPK_CODEC_BOX
                default 9
        endif

        menuconfig ENABLE_CUSTOM_MIC
            bool "Microphone thu âm (Microphone & Audio In)"
            default n
            help
                Cấu hình thu âm giọng nói qua Microphone I2S MEMS hoặc PDM.

        if ENABLE_CUSTOM_MIC
            choice CUSTOM_AUDIO_MIC_TYPE
                prompt "Loại Microphone (Microphone Type)"
                default CUSTOM_AUDIO_MIC_INMP441

                config CUSTOM_AUDIO_MIC_INMP441
                    bool "INMP441 / MSM261S (Microphone số I2S MEMS Omnidirectional)"
                config CUSTOM_AUDIO_MIC_PDM
                    bool "PDM Microphone (Micro số giao thức PDM)"
                config CUSTOM_AUDIO_MIC_CODEC_ES8311
                    bool "Everest Semi ES8311 ADC (I2C)"
                config CUSTOM_AUDIO_MIC_CODEC_ES8388
                    bool "Everest Semi ES8388 ADC (I2C)"
                config CUSTOM_AUDIO_MIC_CODEC_ES8374
                    bool "Everest Semi ES8374 ADC"
                config CUSTOM_AUDIO_MIC_CODEC_ES8389
                    bool "Everest Semi ES8389 ADC"
                config CUSTOM_AUDIO_MIC_CODEC_BOX
                    bool "Box Audio Codec ADC"
            endchoice

            config CUSTOM_AUDIO_MIC_GPIO_DIN
                int "Chân dữ liệu Micro I2S DIN (SD trên INMP441/MSM261S)"
                default 6

            config CUSTOM_AUDIO_MIC_GPIO_SCK
                int "Chân xung nhịp Micro I2S SCK (SCK/BCLK)"
                default 5

            config CUSTOM_AUDIO_MIC_GPIO_WS
                int "Chân chọn kênh Micro I2S WS (WS/LRCK)"
                default 4

            config CUSTOM_AUDIO_MIC_CODEC_I2C_SDA
                int "Chân Codec ADC I2C SDA"
                depends on CUSTOM_AUDIO_MIC_CODEC_ES8311 || CUSTOM_AUDIO_MIC_CODEC_ES8388 || CUSTOM_AUDIO_MIC_CODEC_ES8374 || CUSTOM_AUDIO_MIC_CODEC_ES8389 || CUSTOM_AUDIO_MIC_CODEC_BOX
                default 8

            config CUSTOM_AUDIO_MIC_CODEC_I2C_SCL
                int "Chân Codec ADC I2C SCL"
                depends on CUSTOM_AUDIO_MIC_CODEC_ES8311 || CUSTOM_AUDIO_MIC_CODEC_ES8388 || CUSTOM_AUDIO_MIC_CODEC_ES8374 || CUSTOM_AUDIO_MIC_CODEC_ES8389 || CUSTOM_AUDIO_MIC_CODEC_BOX
                default 9
        endif

        choice CUSTOM_AUDIO_I2S_MODE
            prompt "Chế Độ Xung Nhịp I2S (I2S Clock Mode)"
            default CUSTOM_AUDIO_I2S_SIMPLEX
            help
                Chọn Simplex nếu Loa và Micro chạy trên các kênh xung riêng biệt.
                Chọn Duplex nếu Loa và Micro dùng chung chân BCLK và WS.

            config CUSTOM_AUDIO_I2S_SIMPLEX
                bool "Simplex (Độc lập: Loa và Micro có chân Clock BCLK/WS riêng)"
            config CUSTOM_AUDIO_I2S_DUPLEX
                bool "Duplex (Dùng chung: Loa và Micro chia sẻ chung chân BCLK và WS)"
        endchoice
    endmenu

    menu "3. Giao thức truyền thông & Mạng (Communication, 4G, Ethernet & MCP)"
        menuconfig ENABLE_CUSTOM_UART
            bool "Cổng UART mở rộng (Serial Communication Port)"
            default n
            help
                Giao tiếp nối tiếp UART cho modem 4G, AI thị giác, Robot hoặc servo.

        if ENABLE_CUSTOM_UART
            choice CUSTOM_UART_PORT_NUM
                prompt "Cổng UART Phần Cứng (Hardware UART Port)"
                default CUSTOM_UART_PORT_1

                config CUSTOM_UART_PORT_1
                    bool "UART1 (Cổng serial phần cứng 1)"
                config CUSTOM_UART_PORT_2
                    bool "UART2 (Cổng serial phần cứng 2)"
            endchoice

            choice CUSTOM_UART_USAGE
                prompt "Mục Đích Sử Dụng Cổng UART (UART Usage)"
                default CUSTOM_UART_USAGE_CUSTOM

                config CUSTOM_UART_USAGE_CUSTOM
                    bool "Tùy biến mục đích chung (General Custom UART)"
                config CUSTOM_UART_USAGE_ML307
                    bool "Modem 4G Cat.1 Quectel ML307R"
                config CUSTOM_UART_USAGE_WATCHER
                    bool "SenseCAP Watcher AI Coprocessor (SSCMA)"
                config CUSTOM_UART_USAGE_BUS_SERVO
                    bool "Động cơ thông minh Bus Servo (Fashion Star / Feetech)"
                config CUSTOM_UART_USAGE_ETH_MODEM
                    bool "Modem Ethernet UART"
            endchoice

            config CUSTOM_UART_PIN_TX
                int "Chân phát UART TX GPIO"
                default 17

            config CUSTOM_UART_PIN_RX
                int "Chân nhận UART RX GPIO"
                default 18

            config CUSTOM_UART_BAUDRATE
                int "Tốc độ baud truyền thông (Baudrate)"
                default 115200

            config CUSTOM_UART_USE_FLOW_CONTROL
                bool "Kích hoạt điều khiển luồng phần cứng (RTS/CTS Hardware Flow Control)"
                default n

            config CUSTOM_UART_PIN_RTS
                int "Chân RTS GPIO (Request to Send)"
                depends on CUSTOM_UART_USE_FLOW_CONTROL
                default 19

            config CUSTOM_UART_PIN_CTS
                int "Chân CTS GPIO (Clear to Send)"
                depends on CUSTOM_UART_USE_FLOW_CONTROL
                default 20
        endif

        menuconfig ENABLE_CUSTOM_SECONDARY_NETWORK
            bool "Mạng mở rộng (4G LTE / Ethernet SPI / USB RNDIS)"
            default n
            help
                Kích hoạt kết nối Internet dự phòng hoặc chính qua 4G, cáp mạng Ethernet hoặc USB.

        if ENABLE_CUSTOM_SECONDARY_NETWORK
            choice CUSTOM_SECONDARY_NETWORK_TYPE
                prompt "Loại Giao Thức Mạng Mở Rộng"
                default CUSTOM_NETWORK_4G_ML307

                config CUSTOM_NETWORK_4G_ML307
                    bool "Modem 4G Quectel ML307R (UART AT Commands)"
                config CUSTOM_NETWORK_4G_NT26
                    bool "Modem 4G Neoway NT26 (UART AT Commands)"
                config CUSTOM_NETWORK_4G_EC801E
                    bool "Modem 4G Quectel EC801E (UART AT Commands)"
                config CUSTOM_NETWORK_ETH_W5500
                    bool "Ethernet SPI WIZnet W5500"
                config CUSTOM_NETWORK_ETH_DM9051
                    bool "Ethernet SPI Davicom DM9051"
                config CUSTOM_NETWORK_USB_RNDIS
                    bool "USB RNDIS / CDC-ECM Ethernet over USB"
            endchoice

            config CUSTOM_MODEM_UART_TX_PIN
                int "Chân UART TX kết nối Modem 4G"
                depends on CUSTOM_NETWORK_4G_ML307 || CUSTOM_NETWORK_4G_NT26 || CUSTOM_NETWORK_4G_EC801E
                default 17

            config CUSTOM_MODEM_UART_RX_PIN
                int "Chân UART RX kết nối Modem 4G"
                depends on CUSTOM_NETWORK_4G_ML307 || CUSTOM_NETWORK_4G_NT26 || CUSTOM_NETWORK_4G_EC801E
                default 18

            config CUSTOM_MODEM_PWRKEY_PIN
                int "Chân điều khiển nguồn Modem 4G PWRKEY"
                depends on CUSTOM_NETWORK_4G_ML307 || CUSTOM_NETWORK_4G_NT26 || CUSTOM_NETWORK_4G_EC801E
                default 2

            config CUSTOM_ETH_SPI_CS_PIN
                int "Chân SPI CS của IC Ethernet"
                depends on CUSTOM_NETWORK_ETH_W5500 || CUSTOM_NETWORK_ETH_DM9051
                default 10

            config CUSTOM_ETH_SPI_INT_PIN
                int "Chân ngắt INT của IC Ethernet"
                depends on CUSTOM_NETWORK_ETH_W5500 || CUSTOM_NETWORK_ETH_DM9051
                default 11

            config CUSTOM_ETH_SPI_RST_PIN
                int "Chân Reset của IC Ethernet (-1 nếu không nối)"
                depends on CUSTOM_NETWORK_ETH_W5500 || CUSTOM_NETWORK_ETH_DM9051
                default 14
        endif

        menuconfig ENABLE_CUSTOM_MCP_SERVER
            bool "Giao thức IoT & Tính năng MCP Server (Model Context Protocol)"
            default n
            help
                Cho phép AI Xiaozhi điều khiển các thiết bị ngoại vi và cảm biến qua giao thức MCP Server.

        if ENABLE_CUSTOM_MCP_SERVER
            config CUSTOM_MCP_TOOL_SYSTEM_INFO
                bool "Công cụ MCP: Báo cáo trạng thái hệ thống (Bộ nhớ RAM, Flash, CPU)"
                default y

            config CUSTOM_MCP_TOOL_REBOOT
                bool "Công cụ MCP: Khởi động lại thiết bị từ xa qua AI"
                default y

            config CUSTOM_MCP_TOOL_OTA
                bool "Công cụ MCP: Kiểm tra và kích hoạt nâng cấp Firmware OTA"
                default y

            config CUSTOM_MCP_TOOL_LAMP
                bool "Công cụ MCP: Điều khiển Đèn thông minh / Relay bật tắt qua AI"
                default y

            config CUSTOM_MCP_TOOL_LAMP_GPIO
                int "Chân GPIO điều khiển Đèn / Relay thông minh"
                depends on CUSTOM_MCP_TOOL_LAMP
                default 13

            config CUSTOM_MCP_TOOL_CAMERA
                bool "Công cụ MCP: Chụp ảnh gửi cho AI phân tích thị giác"
                default y

            config CUSTOM_MCP_TOOL_THEME
                bool "Công cụ MCP: Đổi biểu cảm và chủ đề giao diện màn hình"
                default y
        endif
    endmenu

    menu "4. Thiết bị ngoại vi (Peripherals)"
        # 1. Camera
        menuconfig ENABLE_CUSTOM_CAMERA
            bool "Camera & Thị giác AI (Camera DVP / USB UVC)"
            default n
            help
                Bật/tắt hỗ trợ camera chụp ảnh và gửi dữ liệu thị giác cho AI Xiaozhi.

        if ENABLE_CUSTOM_CAMERA
            choice CUSTOM_CAMERA_SENSOR_TYPE
