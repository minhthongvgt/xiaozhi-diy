{
    "type": "esp32-p4-function-ev-board",
    "target": "esp32p4",
    "builds": [
        {
            "name": "waveshare-esp32-p4-module-dev-kit",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_WAVESHARE_ESP32_P4_DEV_KIT=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/16m.csv\"",
                "CONFIG_PARTITION_TABLE_FILENAME=\"partitions/16m.csv\"",
                "CONFIG_SLAVE_IDF_TARGET_ESP32C6=y",
                "CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y",
                "CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y",
                "CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y",
                "CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y",
                "CONFIG_ESP32P4_REV_MIN_100=y"
            ]
        },
        {
            "name": "esp32-p4-function-ev-board",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_ESP32_P4_FUNCTION_EV_BOARD=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/16m.csv\"",
                "CONFIG_PARTITION_TABLE_FILENAME=\"partitions/16m.csv\"",
                "CONFIG_SLAVE_IDF_TARGET_ESP32C6=y",
                "CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y",
                "CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y",
                "CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y",
                "CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y",
                "CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y",
                "CONFIG_ESP32P4_REV_MIN_100=y"
            ]
        },
        {
            "name": "esp32-p4x-function-ev-board",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_ESP32_P4_FUNCTION_EV_BOARD=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/16m.csv\"",
                "CONFIG_PARTITION_TABLE_FILENAME=\"partitions/16m.csv\"",
                "CONFIG_SLAVE_IDF_TARGET_ESP32C6=y",
                "CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y",
                "CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y",
                "CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y",
                "CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y"
            ]
        }
    ]
}
