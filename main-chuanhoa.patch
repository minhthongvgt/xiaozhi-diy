+void scr_unloaded_delete_cb(lv_event_t * e)
+
+{
+
+    // Get the destroy callback from user_data
+
+    screen_destroy_cb_t destroy_cb = lv_event_get_user_data(e);
+    if(destroy_cb) {
+
+        destroy_cb();  // call the specific screen destroy function
+
+    }
+
+}
