+        i2c_master_bus_handle_t existing = bus_manager_get_i2c_bus();
+        if (existing != nullptr) {
+            i2c_bus_ = existing;
+            ESP_LOGI(TAG, "Reusing shared I2C master bus from bus_manager");
+            return;
