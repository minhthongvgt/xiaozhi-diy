-    uint8_t reg_val = 0x40 | (gain & 0x07);
-    esp_err_t ret = vl6180x_write_reg8(handle, VL6180X_REG_SYSALS_ANALOGUE_GAIN, reg_val);
-    if (ret == ESP_OK) {
-        handle->als_gain = gain;
-    }
-    return ret;
