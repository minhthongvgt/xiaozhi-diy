+CircularStrip::~CircularStrip() {
+    if (strip_timer_ != nullptr) {
+        esp_timer_stop(strip_timer_);
+        esp_timer_delete(strip_timer_);
+        strip_timer_ = nullptr;
+    }
+    if (led_strip_ != nullptr) {
+        led_strip_clear(led_strip_);
+        led_strip_del(led_strip_);
+        led_strip_ = nullptr;
+    }
