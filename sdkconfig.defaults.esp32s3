CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# Keep the camera DMA bounce buffer out of internal SRAM so AFE/WakeNet10
# still has a usable internal heap after boot.
CONFIG_CAMERA_PSRAM_DMA=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=10096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6584

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_USE_BUILTIN_MALLOC=y
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_MEM_SIZE_KILOBYTES=1024

# ==============================================================================
# Bo tuy chinh ESP32-S3-N16R8 (Standard ESP-IDF Target Defaults)
# ==============================================================================
# 1. Man hinh SPI ST7796 (320x480)
CONFIG_ENABLE_CUSTOM_DISPLAY=y
CONFIG_CUSTOM_DISPLAY_ST7796=y
CONFIG_CUSTOM_DISPLAY_WIDTH=320
CONFIG_CUSTOM_DISPLAY_HEIGHT=480
CONFIG_CUSTOM_DISPLAY_PIN_MOSI=-1
CONFIG_CUSTOM_DISPLAY_PIN_CLK=-1
CONFIG_CUSTOM_DISPLAY_PIN_CS=-1
CONFIG_CUSTOM_DISPLAY_PIN_DC=-1
CONFIG_CUSTOM_DISPLAY_USE_RST=y
CONFIG_CUSTOM_DISPLAY_PIN_RST=-1
CONFIG_CUSTOM_DISPLAY_USE_BLK=y
CONFIG_CUSTOM_DISPLAY_PIN_BLK=-1
CONFIG_CUSTOM_DISPLAY_INVERT_COLOR=y

# 2. Am thanh Loa PCM5102A & Micro INMP441 (I2S Simplex)
CONFIG_ENABLE_CUSTOM_SPEAKER=y
# CONFIG_CUSTOM_AUDIO_DAC_MAX98357A is not set
CONFIG_CUSTOM_AUDIO_DAC_PCM5102A=y
CONFIG_CUSTOM_AUDIO_SPK_GPIO_DOUT=-1
CONFIG_CUSTOM_AUDIO_SPK_GPIO_BCLK=-1
CONFIG_CUSTOM_AUDIO_SPK_GPIO_LRCK=-1
CONFIG_ENABLE_CUSTOM_MIC=y
CONFIG_CUSTOM_AUDIO_MIC_INMP441=y
CONFIG_CUSTOM_AUDIO_MIC_GPIO_WS=-1
CONFIG_CUSTOM_AUDIO_MIC_GPIO_SCK=-1
CONFIG_CUSTOM_AUDIO_MIC_GPIO_DIN=-1
CONFIG_CUSTOM_AUDIO_I2S_SIMPLEX=y

# 3. Nut bam Boot & Cam bien
CONFIG_CUSTOM_ENABLE_BUTTON_BOOT=y
CONFIG_CUSTOM_BUTTON_BOOT_GPIO=0
CONFIG_ENABLE_CUSTOM_SENSORS=y
CONFIG_CUSTOM_ENABLE_SENSOR_DHT11_22=y
CONFIG_CUSTOM_SENSOR_DHT_GPIO=-1
CONFIG_CUSTOM_BATTERY_MONITOR_NONE=y

# 4. Den LED Trang thai (Status LED)
CONFIG_ENABLE_CUSTOM_LEDS=y
CONFIG_CUSTOM_LED_WS2812=y
CONFIG_CUSTOM_LED_GPIO=48
CONFIG_CUSTOM_LED_COUNT=1
CONFIG_CUSTOM_LED_FAST_RAINBOW_EFFECT=y


# Optimize memory and RTOS responsiveness for S3 N16R8
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_FREERTOS_HZ=1000
